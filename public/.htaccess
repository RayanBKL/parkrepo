<IfModule mod_headers.c>
    # En-tête HSTS (HTTP Strict Transport Security) - Force le HTTPS
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Protection Clickjacking (Anti-Iframe malveillante)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Protection MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Politique Referrer
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Politique de permissions (Désactive l'accès aux APIs sensibles du navigateur si non nécessaires)
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Cross-Origin-Opener-Policy (Isole la page)
    Header always set Cross-Origin-Opener-Policy "same-origin"

    # Masquer la stack technologique (X-Powered-By) de Hostinger / LiteSpeed
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

# Redirection vers l'index pour le routage de l'application React (Single Page Application)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
