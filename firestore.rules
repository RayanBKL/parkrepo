rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fonction utilitaire pour vérifier si l'utilisateur est le Super Admin (Fondateur)
    // Verrouillé strictement sur l'adresse email officielle du fondateur pour interdire toute usurpation
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == "bouaklirayan@gmail.com";
    }
    
    // Fonction pour vérifier si l'organisation associée est active (Non résiliée)
    function isOrgActive(orgId) {
      return orgId == null || 
             isSuperAdmin() || 
             (exists(/databases/$(database)/documents/organizations/$(orgId)) &&
              get(/databases/$(database)/documents/organizations/$(orgId)).data.status in ["ACTIVE", "TRIAL", "trialing"]);
    }
    
    // 1. Utilisateurs (Verrouillage absolu contre l'auto-promotion et l'usurpation d'organisation)
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (resource.data.organizationId != null && 
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId == resource.data.organizationId) ||
        isSuperAdmin()
      );
      
      // À la création, interdire de s'attribuer le rôle SUPERADMIN ou de s'associer à une organisation tierce sans en être propriétaire
      allow create: if request.auth != null && request.auth.uid == userId && (
        isSuperAdmin() || 
        (
          request.resource.data.role != "SUPERADMIN" &&
          (
            // Soit aucune organisation au départ
            request.resource.data.organizationId == null ||
            // Soit l'utilisateur est le créateur/propriétaire légitime de l'organisation
            (
              exists(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)) &&
              get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.ownerId == request.auth.uid
            )
          )
        )
      );
      
      allow update: if request.auth != null && (
        isSuperAdmin()
        ||
        (
          // Branche 1 : L'utilisateur modifie ses propres informations personnelles
          request.auth.uid == userId 
          && request.resource.data.role != "SUPERADMIN"
          && (
               request.resource.data.role == resource.data.role
               // Autoriser à passer OWNER si on vient de créer son org (on est ownerId)
               || (request.resource.data.role == "OWNER" && request.resource.data.organizationId != null && exists(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)) && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.ownerId == request.auth.uid)
             )
          && (
               request.resource.data.organizationId == resource.data.organizationId 
               // Autoriser à rejoindre une org si on en est le propriétaire légitime
               || (request.resource.data.organizationId != null && exists(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)) && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.ownerId == request.auth.uid)
             )
        )
        ||
        (
          // Branche 2 : Le propriétaire de l'organisation gère un autre membre de son équipe
          userId != request.auth.uid 
          && resource.data.organizationId != null 
          && exists(/databases/$(database)/documents/organizations/$(resource.data.organizationId))
          && get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.ownerId == request.auth.uid
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.role != "SUPERADMIN"
          && request.resource.data.role in ['OWNER', 'MANAGER', 'VOITURIER', 'VIEWER']
        )
      );
      
      allow delete: if request.auth != null && (
        isSuperAdmin() ||
        (
          resource.data.organizationId != null &&
          exists(/databases/$(database)/documents/organizations/$(resource.data.organizationId)) &&
          get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.ownerId == request.auth.uid &&
          userId != request.auth.uid
        )
      );
    }
    
    // 2. Organisations / Entreprises & Abonnements (BOUCLIER ANTI-BYPASS FACTURATION)
    match /organizations/{orgId} {
      allow read: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId == orgId) ||
        isSuperAdmin()
      );
      
      // Lors de la création, le statut doit OBLIGATOIREMENT être en attente de paiement
      allow create: if request.auth != null && (
        isSuperAdmin() ||
        (
          request.resource.data.ownerId == request.auth.uid &&
          (!('subscription' in request.resource.data)) &&
          (!('status' in request.resource.data) || request.resource.data.status in ['PENDING_PAYMENT', 'pending_payment', 'TRIAL', 'trialing'])
        )
      );
      
      // Seuls le SUPERADMIN ou les Cloud Functions (Admin SDK) peuvent modifier l'abonnement, le statut ou les clés Stripe
      allow update: if request.auth != null && (
        isSuperAdmin() ||
        (
          resource.data.ownerId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'subscription', 'status', 'stripeCustomerId', 'stripeSubscriptionId', 'ownerId', 'id'
          ])
        )
      );
      
      allow delete: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        isSuperAdmin()
      );
    }
    
    // 3. Codes d'accès (Lecture individuelle réservée au créateur du code, listage interdit)
    match /accessCodes/{codeId} {
      allow get: if request.auth != null && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow list: if false; // Interdit de télécharger la liste complète des codes
      allow create: if request.auth != null && 
        request.resource.data.ownerId == request.auth.uid &&
        exists(/databases/$(database)/documents/parkings/$(request.resource.data.parkingId)) &&
        get(/databases/$(database)/documents/parkings/$(request.resource.data.parkingId)).data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
    }
    
    // 4. Parkings & Véhicules
    match /parkings/{parkingId} {
      allow read: if request.auth != null && (
        (request.auth.uid in resource.data.authorizedUsers && isOrgActive(resource.data.organizationId)) ||
        isSuperAdmin()
      );
      
      // Création de parking : vérifier que l'utilisateur est bien le propriétaire de l'organisation et qu'elle n'est pas annulée
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid && (
        isSuperAdmin() ||
        (
          request.resource.data.organizationId != null &&
          exists(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)) &&
          get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.ownerId == request.auth.uid &&
          isOrgActive(request.resource.data.organizationId)
        )
      );
      
      allow update: if request.auth != null && isOrgActive(resource.data.organizationId) && (
        (request.auth.uid == resource.data.ownerId && request.resource.data.organizationId == resource.data.organizationId)
        ||
        (
          // Membre existant fait une modification
          request.auth.uid in resource.data.authorizedUsers &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.organizationId == resource.data.organizationId &&
          resource.data.ownerId in request.resource.data.authorizedUsers &&
          (
            // S'il est OWNER ou MANAGER, il peut tout modifier (sauf ownerId/orgId bloqués au-dessus)
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "OWNER" ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "MANAGER"
            ||
            // S'il est seulement VOITURIER, il ne peut modifier QUE lanes, updatedAt, ou se retirer lui-même de authorizedUsers
            (
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "VOITURIER" &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lanes', 'updatedAt', 'authorizedUsers']) &&
              (
                !('authorizedUsers' in request.resource.data.diff(resource.data).affectedKeys()) ||
                !(request.auth.uid in request.resource.data.authorizedUsers)
              )
            )
          )
        )
        ||
        isSuperAdmin()
      );
      
      allow delete: if request.auth != null && (request.auth.uid == resource.data.ownerId || isSuperAdmin());
    }

    // 5. Réservations
    match /reservations/{resId} {
      allow read: if request.auth != null && (
        isSuperAdmin() ||
        (resource.data.parkingId != null && 
         exists(/databases/$(database)/documents/parkings/$(resource.data.parkingId)) &&
         request.auth.uid in get(/databases/$(database)/documents/parkings/$(resource.data.parkingId)).data.authorizedUsers)
      );
      
      allow create: if request.auth != null && (
        isSuperAdmin() ||
        (request.resource.data.parkingId != null &&
         exists(/databases/$(database)/documents/parkings/$(request.resource.data.parkingId)) &&
         request.auth.uid in get(/databases/$(database)/documents/parkings/$(request.resource.data.parkingId)).data.authorizedUsers)
      );
      
      allow update, delete: if request.auth != null && (
        isSuperAdmin() ||
        (resource.data.parkingId != null &&
         exists(/databases/$(database)/documents/parkings/$(resource.data.parkingId)) &&
         request.auth.uid in get(/databases/$(database)/documents/parkings/$(resource.data.parkingId)).data.authorizedUsers)
      );
    }

    // 6. Invitations d'employés
    match /invitations/{inviteId} {
      allow read: if request.auth != null && (
        isSuperAdmin() ||
        request.auth.token.email == resource.data.email ||
        (resource.data.organizationId != null &&
         exists(/databases/$(database)/documents/organizations/$(resource.data.organizationId)) &&
         get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.ownerId == request.auth.uid)
      );
      
      allow create: if request.auth != null && (
        isSuperAdmin() ||
        (request.resource.data.organizationId != null &&
         exists(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)) &&
         get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.ownerId == request.auth.uid)
      );
      
      allow update: if request.auth != null && (
        isSuperAdmin() ||
        (resource.data.organizationId != null &&
         exists(/databases/$(database)/documents/organizations/$(resource.data.organizationId)) &&
         get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.ownerId == request.auth.uid) ||
        (request.auth.token.email == resource.data.email && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );
      
      allow delete: if request.auth != null && (
        isSuperAdmin() ||
        (resource.data.organizationId != null &&
         exists(/databases/$(database)/documents/organizations/$(resource.data.organizationId)) &&
         get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.ownerId == request.auth.uid)
      );
    }
  }
}
