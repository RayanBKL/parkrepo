rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fonction utilitaire pour vérifier si l'utilisateur est le Super Admin (Fondateur)
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == "bouaklirayan@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "SUPERADMIN")
      );
    }
    
    // 1. Utilisateurs
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (resource.data.organizationId != null && 
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId == resource.data.organizationId) ||
        isSuperAdmin()
      );
      
      allow create: if request.auth != null && request.auth.uid == userId;
      
      allow update: if request.auth != null && (
        (
          request.auth.uid == userId 
          && (
               request.resource.data.role == resource.data.role
               // Autoriser à passer OWNER si on vient de créer son org (on est ownerId)
               || (request.resource.data.role == "OWNER" && request.resource.data.organizationId != null && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.ownerId == request.auth.uid)
             )
          && (
               request.resource.data.organizationId == resource.data.organizationId 
               // Autoriser à rejoindre une org si on en est le propriétaire
               || (request.resource.data.organizationId != null && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.ownerId == request.auth.uid)
             )
        )
        ||
        (
          resource.data.organizationId != null 
          && get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.ownerId == request.auth.uid
        )
        ||
        isSuperAdmin()
      );
    }
    
    // 2. Organisations / Entreprises & Abonnements (BOUCLIER ANTI-BYPASS FACTURATION)
    match /organizations/{orgId} {
      allow read: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId == orgId) ||
        isSuperAdmin()
      );
      
      // Lors de la création, le statut doit OBLIGATOIREMENT être en attente de paiement
      allow create: if request.auth != null && (
        isSuperAdmin() ||
        (
          request.resource.data.ownerId == request.auth.uid &&
          (!('status' in request.resource.data) || request.resource.data.status in ['PENDING_PAYMENT', 'pending_payment', 'TRIAL', 'trialing'])
        )
      );
      
      // Seuls le SUPERADMIN ou les Cloud Functions (Admin SDK) peuvent modifier l'abonnement, le statut ou les clés Stripe
      allow update: if request.auth != null && (
        isSuperAdmin() ||
        (
          resource.data.ownerId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'subscription', 'status', 'stripeCustomerId', 'stripeSubscriptionId', 'ownerId', 'id'
          ])
        )
      );
      
      allow delete: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        isSuperAdmin()
      );
    }
    
    // 3. Codes d'accès & invitations (Lecture individuelle uniquement, listage interdit)
    match /accessCodes/{codeId} {
      allow get: if request.auth != null; // Autorise uniquement la lecture si on connaît le code exact
      allow list: if false; // Interdit de télécharger la liste complète des codes
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
    }
    
    // 4. Parkings & Véhicules
    match /parkings/{parkingId} {
      allow read: if request.auth != null && (
        (request.auth.uid in resource.data.authorizedUsers) ||
        isSuperAdmin()
      );
      
      // Création de parking : vérifier que l'utilisateur est bien le propriétaire de l'organisation
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid && (
        isSuperAdmin() ||
        (
          request.resource.data.organizationId != null &&
          get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.ownerId == request.auth.uid
        )
      );
      
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.ownerId)
        ||
        (
          // Membre existant fait une modification
          request.auth.uid in resource.data.authorizedUsers &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.organizationId == resource.data.organizationId &&
          resource.data.ownerId in request.resource.data.authorizedUsers &&
          (
            // S'il est OWNER ou MANAGER, il peut tout modifier (sauf ownerId/orgId bloqués au-dessus)
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "OWNER" ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "MANAGER"
            ||
            // S'il est seulement VOITURIER, il ne peut modifier QUE lanes, updatedAt, ou se retirer lui-même de authorizedUsers
            (
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "VOITURIER" &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lanes', 'updatedAt', 'authorizedUsers']) &&
              (
                !('authorizedUsers' in request.resource.data.diff(resource.data).affectedKeys()) ||
                !(request.auth.uid in request.resource.data.authorizedUsers)
              )
            )
          )
        )
        ||
        isSuperAdmin()
      );
      
      allow delete: if request.auth != null && (request.auth.uid == resource.data.ownerId || isSuperAdmin());
    }

    // 5. Réservations
    match /reservations/{resId} {
      allow read: if request.auth != null && (
        isSuperAdmin() ||
        (resource.data.parkingId != null && 
         request.auth.uid in get(/databases/$(database)/documents/parkings/$(resource.data.parkingId)).data.authorizedUsers)
      );
      
      allow create: if request.auth != null && (
        isSuperAdmin() ||
        (request.resource.data.parkingId != null &&
         request.auth.uid in get(/databases/$(database)/documents/parkings/$(request.resource.data.parkingId)).data.authorizedUsers)
      );
      
      allow update, delete: if request.auth != null && (
        isSuperAdmin() ||
        (resource.data.parkingId != null &&
         request.auth.uid in get(/databases/$(database)/documents/parkings/$(resource.data.parkingId)).data.authorizedUsers)
      );
    }

    // 6. Invitations d'employés
    match /invitations/{inviteId} {
      allow read: if request.auth != null && (
        isSuperAdmin() ||
        request.auth.token.email == resource.data.email ||
        (resource.data.organizationId != null &&
         get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.ownerId == request.auth.uid)
      );
      
      allow create: if request.auth != null && (
        isSuperAdmin() ||
        (request.resource.data.organizationId != null &&
         get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.ownerId == request.auth.uid)
      );
      
      allow update, delete: if request.auth != null && (
        isSuperAdmin() ||
        (resource.data.organizationId != null &&
         get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.ownerId == request.auth.uid)
      );
    }
  }
}
